{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariz-learn",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LEARN_API_ENABLED": "false"
  }
}
