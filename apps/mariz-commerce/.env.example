# MARIZ COMMERCE / REFERENCE ONLY — never commit real values
NODE_ENV=development
COMMERCE_MODE=mock
COMMERCE_ENABLE_REAL_PAYMENTS=false
COMMERCE_ENABLE_REAL_COURIER_BOOKING=false
COMMERCE_BASE_URL=http://localhost:3000
# Neon / HQ — reuse existing MARIZ HQ V2 integration and secret management; do not paste passwords in a PR
DATABASE_URL=
HQ_AUTH_ISSUER=
HQ_AUTH_AUDIENCE=
HQ_API_BASE_URL=
# Shared key-encryption vault/KMS reference, not a plaintext master key in browser code
COMMERCE_SECRET_VAULT_REF=
# Billplz: merchant specific credentials are encrypted DB/vault refs; these only describe env config
BILLPLZ_MODE=sandbox
BILLPLZ_SANDBOX_BASE_URL=https://www.billplz-sandbox.com/api
BILLPLZ_PRODUCTION_BASE_URL=https://www.billplz.com/api
BILLPLZ_WEBHOOK_PUBLIC_URL=
# Do not reuse HQ's Billplz platform subscription credentials as merchant sales credentials
# Lalamove: merchant specific API keys are stored per tenant in server vault
LALAMOVE_MODE=sandbox
LALAMOVE_SANDBOX_URL=https://rest.sandbox.lalamove.com
LALAMOVE_PRODUCTION_URL=https://rest.lalamove.com
LALAMOVE_MARKET=MY
LALAMOVE_WEBHOOK_PUBLIC_URL=
# Hostname mapping and publishing
COMMERCE_CUSTOM_DOMAIN_ENABLED=false
COMMERCE_PUBLISH_ENABLED=false
# All real activation flags default OFF until tested and approved

# WhatsApp Business: META EMBEDDED SIGNUP / DISABLED UNTIL REVIEW
# Meta App ID & config ID are PUBLIC identifiers; app secret stays server-only
COMMERCE_WHATSAPP_CHAT_LINK_ENABLED=false
COMMERCE_WHATSAPP_META_CONNECT_ENABLED=false
COMMERCE_WHATSAPP_OUTBOUND_ENABLED=false
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Per-merchant tokens and phone/account IDs must be stored via HQ credential vault,
# not as shared environment variables. Do not enable without tenant authorization.
