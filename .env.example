# MARIZ HQ V2 / dedicated Neon PostgreSQL 17 project: MARIZ HQ V2 Isolated ONLY
# Server-only connection must use mariz_v2_runtime (NOT neon database owner).
MARIZ_NEON_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Do not enable before provider-level email verification, KYB security tests, and QA.
NEON_V2_ENABLED=false
MARIZ_CO_PUBLIC_SIGNUP_ENABLED=false
MARIZ_EMAIL_VERIFICATION_ENFORCED=false
MARIZ_KYB_DOCUMENT_UPLOADS_ENABLED=false
NEXT_PUBLIC_MARIZ_APP_URL=https://mariz-hq-v2-preview.vercel.app

# LEGACY Supabase adapter: unused by Neon MARIZ CO; do NOT supply live V1/Supabase URLs
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Operational POS remains disabled. Never expose secrets as NEXT_PUBLIC_* variables.
MARIZ_POS_PIN_PEPPER=
MARIZ_POS_LIVE_TERMINALS_ENABLED=false
