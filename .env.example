# MARIZ HQ V2 — dedicated isolated Supabase project ONLY.
# Never reuse Shahira, MARIZ HQ V1 or any existing shared production database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MARIZ_APP_URL=https://mariz-hq-v2-preview.vercel.app

# Server runtime only. NEVER prefix these values with NEXT_PUBLIC.
# Do not configure or enable until isolated V2 database, migrations and tests pass.
SUPABASE_SERVICE_ROLE_KEY=
MARIZ_POS_PIN_PEPPER=

# Fail-closed. Do NOT enable until device/session acceptance and operational audit.
MARIZ_POS_LIVE_TERMINALS_ENABLED=false
