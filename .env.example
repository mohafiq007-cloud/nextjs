# MARIZ HQ V2 ONLY — Neon Free isolated project, not Shahira/MHQ/Kiefa.
# All Neon auth and database secrets are server-only. Never use NEXT_PUBLIC_*.
# Merchant-order staging slice. Default OFF; production is denied independently.
MARIZ_COMMERCE_STAGING_ENABLED=false
MARIZ_COMMERCE_STAGING_ORIGIN=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# HTTPS Neon Data API endpoint for the isolated marizhq_v2/main database.
# The application rejects all hosts except the pinned project endpoint.
NEON_DATA_API_URL=
# Requires separate, independently validated least-privilege runtime login.
MARIZ_NEON_DATABASE_URL=
# Fail-closed flags until verification policy, least-privilege and E2E tests pass.
NEON_V2_ENABLED=false
NEON_PUBLIC_REGISTRATION_ENABLED=false
MARIZ_CO_PUBLIC_SIGNUP_ENABLED=false
MARIZ_EMAIL_VERIFICATION_ENFORCED=false
# Historical Supabase routes remain disabled in the Neon V2 integration.
MARIZ_POS_LIVE_TERMINALS_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
MARIZ_POS_PIN_PEPPER=

# Billplz sandbox integration (off by default; credentials NEVER committed).
# Each sandbox account has separate credentials from the production account.
# No prices or subscriptions are configured.
MARIZ_BILLPLZ_ENABLED=false
BILLPLZ_ENV=sandbox
BILLPLZ_SECRET_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Absolute HTTPS URL of the isolated MARIZ HQ V2 sandbox preview, no path.
BILLPLZ_PUBLIC_BASE_URL=

# Server-only restricted runtime connections. No owner/elevated role is accepted.
# Both connections must target this exact project/branch endpoint hostname.
MARIZ_NEON_DATABASE_HOST=
# MARIZ_NEON_DATABASE_URL is legacy POS/backoffice only, NOT needed for CO signup.
# If enabled for other features it must use mariz_runtime_restricted.
# MARIZ_BILLING_DATABASE_URL must use mariz_billing_runtime_limited.
# Both require sslmode=require&channel_binding=require.
# Missing billing credentials keep the Billplz callback disabled.
MARIZ_BILLING_DATABASE_URL=

# Comma-separated verified Neon user UUIDs; empty means no operator is allowed.
# The database also requires owner/admin membership of an explicitly approved sandbox organization.
MARIZ_BILLPLZ_OPERATOR_IDS=
